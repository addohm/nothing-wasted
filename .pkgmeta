# Packaging for the BigWigs packager (used by CurseForge and Wago release automation).
# The addon lives in NothingWasted/; everything else in the repository stays out of the zip.
package-as: NothingWasted

move-folders:
  NothingWasted/NothingWasted: NothingWasted

ignore:
  - tests
  - RestedRoster
  - "*.md"
  - "*.cmd"
  - .gitignore
